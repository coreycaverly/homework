rules_version = '2';

// Homework Helper — Firestore security rules.
// Deploy these in: Firebase console → Firestore Database → Rules → Publish.
//
// Model:
//   users/{uid} = { progress: {..}, displayName, email, role?, updatedAt }
//   - A signed-in user may read and write ONLY their own doc.
//   - A user may NOT set or change their own `role` (so nobody self-grants parent).
//   - Admins (UID allowlist below) may read every user and set/clear roles.
//
// After your first sign-in, copy your UID from
// Authentication → Users into BOTH the list below and assets/firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "UnV9SrcUQBgnP3tObnyHMvV6Ol43",
        "mzsQ7kcc1JdWi4Z5LdjS7Yw7xDj2"
      ];
    }
    function roleOf(d) {
      return ('role' in d) ? d.role : null;
    }

    match /users/{uid} {
      // Admins can do anything (grant/revoke parent, read the user list).
      allow read, write: if isAdmin();

      // Owner can read their own doc.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Owner can create their own doc but may not include a role.
      allow create: if request.auth != null && request.auth.uid == uid
                    && !('role' in request.resource.data);

      // Owner can update their own doc (progress/profile) but may not change role.
      allow update: if request.auth != null && request.auth.uid == uid
                    && roleOf(request.resource.data) == roleOf(resource.data);
    }

    // Lesson lock state, toggled by admins on /admin.html.
    //   config/lessons = { locks: { "<slug>": true|false } }
    // Public read (the lock list isn't secret; it only hides lessons in the UI);
    // only admins can change it.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Writing-feedback queue. The site writes a request; the local worker on
    // "Dune" (Firebase Admin SDK, which bypasses these rules) runs the model and
    // writes the response back.
    //   feedbackRequests/{id} = { uid, kind, input, status, response?, model?, createdAt }
    match /feedbackRequests/{id} {
      // A signed-in user may create ONLY their own request, as "pending", with no response.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && !('response' in request.resource.data);
      // They may read and delete only their own request (delete = cleanup after reading).
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      // Only the worker (Admin SDK) updates — it fills in the response.
      allow update: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
