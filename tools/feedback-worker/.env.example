# Copy to `.env` (or export these) on Dune. The worker reads env vars directly;
# if you use a .env file, start with:  node -r dotenv/config worker.js
# (or just `export` them in your shell / launchd plist).

# Path to the Firebase service-account key JSON (keep it OUT of git).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Ollama endpoint (the worker runs ON Dune, so localhost).
OLLAMA_URL=http://127.0.0.1:11434

# Which model to coach with. On Apple Silicon prefer the MLX builds (much faster).
# Benchmarked for this warm, grammar-aware coaching (thinking off):
#   gemma4:12b-mlx  (~2s, best balance — recommended)
#   gemma4:e4b-mlx  (~1s, snappiest, slightly less rich)
#   gemma4:31b-mlx  (~7s, marginally more thorough, not worth the wait here)
# Gemma 4 are "thinking" models — the worker already sends think:false so they
# answer directly. GGUF (non-mlx) builds are much slower on a Mac; avoid them.
OLLAMA_MODEL=gemma4:12b-mlx

# Generation timeout (ms) and max characters of student input.
GEN_TIMEOUT_MS=180000
MAX_INPUT_CHARS=4000
